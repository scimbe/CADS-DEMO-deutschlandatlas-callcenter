# Deutschlandatlas Sprach-Callcenter — runtime env template (NAMES + descriptions only; NO secret values).
# Copy to .env, fill in the values, run with: docker run --env-file .env ...
# Values baked into the image (CC_HOST, PORT, CC_TTS, CC_WHISPER_MODEL, CC_WHISPER_CLI, CT_AGENT_BIN)
# do not need to be repeated here unless you want to override them.

# --- LLM (litellm-proxy, OpenAI-compatible) ---
LITELLM_BASE_URL=        # e.g. https://llm-<hash>.bunsenbrenner.org
LITELLM_API_KEY=         # bearer key for the proxy
LITELLM_DEFAULT_MODEL=   # e.g. local-devstral-small2

# --- optional overrides (defaults are baked into the image) ---
# CC_HOST=0.0.0.0        # bind host inside the container (default 0.0.0.0 in the image)
# PORT=8791
# CC_WHISPER_MODEL=/app/models/ggml-base.bin
# CC_WHISPER_CLI=whisper-cli

# --- ct-agent audio_generation channel (Thorsten TTS) ---
# CT_AGENT_BIN is baked (/usr/local/bin/ct-agent). The rest come from the audio-channel grant,
# coordinated with Maintainer labor. CT_RELAY_ENV points at a file holding the CT_CHANNEL_* secrets;
# either mount that file and set CT_RELAY_ENV to its path, OR pass the CT_CHANNEL_* vars directly.
CT_RELAY_ENV=            # path to a file exporting the CT_CHANNEL_* secrets below (or set them directly)
CT_AUDIO_CHANNEL_ID=     # the audio_generation channel id (public)
CT_MANIFEST_TRUST_ALLOWLIST=   # trust allowlist hash

# CT_CHANNEL_* secrets (live in CT_RELAY_ENV; listed here so the set is complete). SECRETS — do not commit.
# CT_CHANNEL_ID=
# CT_CHANNEL_GRANT_2E=          # the signed grant for the audio channel
# CT_CHANNEL_HOLDER_KEY=        # private
# CT_CHANNEL_NOISE_KEY=         # private
# CT_CHANNEL_FRONT_DOOR=        # e.g. bunsenbrenner.org:443
# CT_CHANNEL_FRONT_DOOR_CERT=   # DER cert (path or value per your relay-env convention)
# CT_CHANNEL_BROKER=            # e.g. bunsenbrenner.org:4435
# CT_CHANNEL_RELAY=             # e.g. bunsenbrenner.org:4436
