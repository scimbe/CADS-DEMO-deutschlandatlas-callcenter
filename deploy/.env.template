# Deutschlandatlas Sprach-Callcenter — runtime env template (NAMES + descriptions only; NO secret values).
# Copy to .env, fill in the values, run with: docker run --env-file .env ...
#
# This deployment is SELF-CONTAINED: STT (whisper.cpp), TTS (local Piper + bundled Thorsten voice) and
# the pipeline runtime all run in the container. The ONLY external runtime dependency is the LLM proxy.
# No ct-agent channel, no grant, no cross-host audio dependency.

# --- LLM (litellm-proxy, OpenAI-compatible) — the only external dependency ---
LITELLM_BASE_URL=        # e.g. https://llm-<hash>.bunsenbrenner.org
LITELLM_API_KEY=         # bearer key for the proxy
LITELLM_DEFAULT_MODEL=   # e.g. local-devstral-small2

# --- everything below is baked into the image; override only if you must ---
# CC_HOST=0.0.0.0                 # bind host (image default 0.0.0.0 so a fronting tunnel can reach it)
# PORT=8791
# CC_TTS=1                        # enable TTS
# CC_WHISPER_MODEL=/app/models/ggml-base.bin
# CC_WHISPER_CLI=whisper-cli
# CC_PIPER_BIN=/opt/piper/piper           # presence of CC_PIPER_BIN + CC_PIPER_MODEL selects local Piper
# CC_PIPER_MODEL=/app/voices/de_DE-thorsten-medium.onnx

# --- ct-agent audio channel: NOT USED in this self-contained deployment ---
# (Left here only as a note: if CC_PIPER_BIN/CC_PIPER_MODEL are unset, ttsSpeak falls back to a
#  ct-agent audio_generation channel via CT_AGENT_BIN/CT_RELAY_ENV/CT_AUDIO_CHANNEL_ID — the dev setup.
#  The container does not need any of those.)
