# Deutschlandatlas Sprach-Callcenter — runtime env template (NAMES + descriptions only; NO secret values).
# Copy to .env, fill in the values, run with: docker run --env-file .env ...
#
# TTS is served THROUGH the llm2/labor agent `audio_generation` channel (Thorsten voice) — this is the
# production voice path. STT (whisper.cpp) and the pipeline runtime run in the container. External
# runtime dependencies: the LLM proxy AND the audio channel. Local Piper is bundled ONLY as an explicit
# offline fallback (used solely when NO channel env is provided).

# --- LLM (litellm-proxy, OpenAI-compatible) ---
LITELLM_BASE_URL=        # e.g. https://llm-<hash>.bunsenbrenner.org
LITELLM_API_KEY=         # bearer key for the proxy
LITELLM_DEFAULT_MODEL=   # e.g. local-devstral-small2

# --- TTS: agent audio_generation channel (PRODUCTION voice path — llm2 / labor) ---
# When all three are set, ttsSpeak() uses the channel and takes precedence over local Piper.
CC_TTS=1                  # enable TTS
CT_AGENT_BIN=            # path to the ct-agent binary inside the container
CT_RELAY_ENV=            # path to the relay env-file (sourced at call time; holds grant/holder/noise keys)
CT_AUDIO_CHANNEL_ID=     # the audio_generation channel id operated by llm2 / labor
# The relay env-file (CT_RELAY_ENV) provides, and MUST NOT be committed:
#   CT_CHANNEL_GRANT_2E, CT_CHANNEL_HOLDER_KEY, CT_CHANNEL_NOISE_KEY, CT_CHANNEL_FRONT_DOOR_CERT

# --- everything below is baked into the image; override only if you must ---
# CC_HOST=0.0.0.0                 # bind host (image default 0.0.0.0 so a fronting tunnel can reach it)
# PORT=8791
# CC_WHISPER_MODEL=/app/models/ggml-base.bin
# CC_WHISPER_CLI=whisper-cli

# --- Local Piper: OFFLINE FALLBACK ONLY (used only when the channel env above is absent) ---
# Leave these UNSET in production so the agent channel is used. Set them only for a fully offline deploy.
# CC_PIPER_BIN=/opt/piper/piper
# CC_PIPER_MODEL=/app/voices/de_DE-thorsten-medium.onnx
