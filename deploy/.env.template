# Deutschlandatlas Sprach-Callcenter — runtime env template (NAMES + descriptions only; NO secret values).
# Copy to .env, fill in the values, run with: docker run --env-file .env ...
#
# TTS is CHANNEL-FIRST with a Piper runtime fallback (operator choice: "Channel + Piper-Fallback").
# The llm2 agent `audio_generation` channel (Thorsten voice) is the production voice when reachable;
# if a channel call fails at request time, the bundled local Piper synthesizes instead, so a turn is
# never silent. STT (whisper.cpp) and the pipeline runtime run in the container. RECOMMENDED PRODUCTION
# CONFIG: set BOTH the channel vars AND CC_PIPER_* (channel primary, Piper fallback).

# --- LLM (litellm-proxy, OpenAI-compatible) ---
LITELLM_BASE_URL=        # e.g. https://llm-<hash>.bunsenbrenner.org
LITELLM_API_KEY=         # bearer key for the proxy
LITELLM_DEFAULT_MODEL=   # e.g. local-devstral-small2

# --- TTS: agent audio_generation channel (PRODUCTION voice path — llm2 / labor) ---
# When all three are set, ttsSpeak() uses the channel and takes precedence over local Piper.
CC_TTS=1                  # enable TTS
CT_AGENT_BIN=            # path to the ct-agent binary inside the container
CT_RELAY_ENV=            # path to the relay env-file (sourced at call time; holds grant/holder/noise keys)
CT_AUDIO_CHANNEL_ID=     # the audio_generation channel id operated by llm2 / labor
# The relay env-file (CT_RELAY_ENV) provides, and MUST NOT be committed:
#   CT_CHANNEL_GRANT_2E, CT_CHANNEL_HOLDER_KEY, CT_CHANNEL_NOISE_KEY, CT_CHANNEL_FRONT_DOOR_CERT

# --- AI provider switch (gui/lib/providers/config.mjs) ---
# "local" (default) = everything above (litellm-proxy + the llm2 channel/Piper/whisper.cpp),
# entirely EU-hosted, DSGVO-conform. "cloudflare" = Cloudflare Workers AI — see the per-service
# credentials below. AI_PROVIDER sets the default for all three; LLM_PROVIDER/TTS_PROVIDER/
# STT_PROVIDER override it individually (mix and match — only some services need to switch).
# Switching ANY of these to "cloudflare" makes the app show a GDPR/DSGVO notice in the GUI.
# These are only the STARTUP defaults — GET /admin (token-gated by ADMIN_TOKEN below) switches
# any of the three at runtime, no restart needed; a restart reverts to whatever's set here.
# AI_PROVIDER=local
# LLM_PROVIDER=local
# TTS_PROVIDER=local
# STT_PROVIDER=local

# --- Admin (runtime provider switch, GET/POST /admin/providers + the GET /admin dropdown page) ---
# Unset (default): /admin/providers is disabled (404) entirely — set a long random value to enable
# it. Required as the x-admin-token header on every /admin/providers call; the dropdown page itself
# is not secret, only the API calls it makes are gated.
# ADMIN_TOKEN=

# --- Cloudflare Workers AI (https://developers.cloudflare.com/workers-ai/) ---
# Only needed if AI_PROVIDER (or one of the per-service overrides above) is "cloudflare".
# Put real values in .env at the repo root for local dev (loaded automatically, never committed —
# already in .gitignore) or as real container env vars for a deploy. Free-plan-friendly model
# defaults are baked into gui/lib/providers/cloudflare.mjs; override the *_MODEL vars only if you
# know you want a different (likely more expensive) model.
# CLOUDFLARE_ACCOUNT_ID=      # from your Cloudflare dashboard URL
# CLOUDFLARE_API_TOKEN=       # My Profile -> API Tokens, needs the "Workers AI" permission
# CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# CLOUDFLARE_STT_MODEL=@cf/openai/whisper
# CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts

# --- everything below is baked into the image; override only if you must ---
# CC_HOST=0.0.0.0                 # bind host (image default 0.0.0.0 so a fronting tunnel can reach it)
# PORT=8791
# CC_WHISPER_MODEL=/app/models/ggml-base.bin
# CC_WHISPER_CLI=whisper-cli

# --- Local Piper: RUNTIME FALLBACK (recommended: keep these SET alongside the channel vars) ---
# With the channel vars set too, Piper is used only when a channel call fails at request time -> never
# silent. Baked into the image by default; unset both only for a deliberate channel-only deploy.
# CC_PIPER_BIN=/opt/piper/piper
# CC_PIPER_MODEL=/app/voices/de_DE-thorsten-medium.onnx
